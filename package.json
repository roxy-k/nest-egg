{
  "name": "nested-egg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:server && npm run test:client",
    "test:server": "NODE_ENV=test node server/node_modules/mocha/bin/mocha.js \"server/tests/**/*.test.js\" --timeout 10000",
    "test:server:watch": "NODE_ENV=test node server/node_modules/mocha/bin/mocha.js \"server/tests/**/*.test.js\" --watch --timeout 10000",
    "test:server:cov": "NODE_ENV=test node node_modules/c8/bin/c8.js --clean --reporter=text --reporter=html --reports-dir=server/coverage --include=server/src node server/node_modules/mocha/bin/mocha.js \"server/tests/**/*.test.js\" --timeout 10000",
    "test:client": "vitest run",
    "test:client:watch": "vitest",
    "test:client:cov": "vitest run --coverage",
    "test:cov": "npm run test:server:cov && npm run test:client:cov",
    "prepare": "husky || true"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "file-saver": "^2.0.5",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "sib-api-v3-sdk": "^8.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "chai-http": "^5.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.5.2",
    "mocha": "^11.7.4",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "lint-staged": {
    "*.{js,jsx,json,css}": [
      "npm run lint -- --fix"
    ]
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "server",
    "client"
  ]
}
